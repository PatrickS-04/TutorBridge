<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ system splash: plain cream behind the launcher bridge, matching the in-app splash artwork. -->
<resources>
    <style name="Theme.TutorBridge" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">#F4EFE6</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">#F4EFE6</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowSplashScreenBackground">#F4EFE6</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>
</resources>
